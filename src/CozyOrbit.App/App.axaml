<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CozyOrbit.App.App"
             RequestedThemeVariant="Dark">
  <!-- 색 브러시(SpaceBrush·PanelBrush …)는 App.axaml.cs 가 Core 의 Palette 에서 만들어 넣는다 → 여기서는 DynamicResource 로만 -->
  <Application.Resources>
    <FontFamily x:Key="PixelFont">avares://CozyOrbit/Assets/Fonts#Galmuri11</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource SpaceDeepBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize" Value="24" />
    </Style>

    <!-- 도트 패널: 모서리 없음, 2px 테두리 -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource PanelLightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="6" />
    </Style>

    <!-- 도트 버튼 -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource PanelLightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="translate(0px, 1px)" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>
    <!-- Fluent 에도 accent 클래스가 있고 템플릿 ContentPresenter 를 칠한다 → 같은 선택자로 덮어야 별빛색이 이긴다 -->
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StarlightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OutlineBrush}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CreamBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OutlineBrush}" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GoldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OutlineBrush}" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>

    <!-- 탭 버튼 -->
    <Style Selector="ToggleButton.tab">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="2,2,2,0" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>
    <Style Selector="ToggleButton.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelLightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ToggleButton.tab:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="8" />
      <Setter Property="Background" Value="{DynamicResource SpaceDeepBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
    </Style>
    <!-- Fluent 의 ProgressBar:horizontal 기본 MinWidth(200)는 작은 칸을 넘친다 (같은 선택자로 덮어야 이긴다) -->
    <Style Selector="ProgressBar:horizontal">
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="ProgressBar /template/ Border">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
