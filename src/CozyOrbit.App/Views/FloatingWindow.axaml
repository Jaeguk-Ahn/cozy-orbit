<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:CozyOrbit.App.Views"
        xmlns:l="using:CozyOrbit.App.Infra"
        x:Class="CozyOrbit.App.Views.FloatingWindow"
        Title="{l:T Ko='코지 오빗', En='Cozy Orbit'}"
        Width="300" Height="180" MinWidth="220" MinHeight="150"
        Topmost="True" SystemDecorations="None" ShowInTaskbar="False" CanResize="True"
        SizeToContent="Manual" WindowStartupLocation="Manual"
        Background="{DynamicResource SpaceDeepBrush}">
  <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="2">
    <Panel>
      <v:SceneView x:Name="Scene" />

      <!-- 거리 · 별빛 (항상 보임, 작게) -->
      <Border x:Name="Hud" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Padding="5,3"
              BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" IsHitTestVisible="False">
        <StackPanel Spacing="3">
          <TextBlock x:Name="DistanceText" />
          <ProgressBar x:Name="BatteryBar" Minimum="0" Maximum="1" Height="5" MinHeight="5" Width="96"
                       Foreground="{DynamicResource StarlightBrush}" />
        </StackPanel>
      </Border>

      <!-- 마우스를 올리면 나타나는 버튼 -->
      <StackPanel x:Name="Controls" Orientation="Horizontal" Spacing="3" IsVisible="False"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
        <Button x:Name="OpenButton" Padding="6,2" Content="{l:T Ko='큰 창', En='Main'}" />
        <Button x:Name="CloseButton" Padding="6,2" Content="{l:T Ko='닫기', En='Close'}" />
      </StackPanel>

      <!-- 크기 조절 손잡이 (오른쪽 아래) -->
      <Canvas x:Name="Grip" Width="14" Height="14" IsVisible="False" Background="Transparent"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" Cursor="BottomRightCorner">
        <Rectangle Canvas.Left="10" Canvas.Top="2" Width="2" Height="2" Fill="{DynamicResource TextBrush}" />
        <Rectangle Canvas.Left="6" Canvas.Top="6" Width="2" Height="2" Fill="{DynamicResource TextBrush}" />
        <Rectangle Canvas.Left="10" Canvas.Top="6" Width="2" Height="2" Fill="{DynamicResource TextBrush}" />
        <Rectangle Canvas.Left="2" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource TextBrush}" />
        <Rectangle Canvas.Left="6" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource TextBrush}" />
        <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource TextBrush}" />
      </Canvas>
    </Panel>
  </Border>
</Window>
